{
  "manifest_version": 3,
  "name": "D2L Pull",
  "version": "2.1.0",
  "description": "One-click Brightspace (D2L) rosters/grades and CompTIA CertMaster lab/quiz exports, with optional CompTIA-to-D2L conversion.",
  "key": "",
  "action": {
    "default_title": "D2L Pull",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://d2l.pcc.edu/*",
    "https://platform.comptia.org/*",
    "https://api.platform.comptia.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}

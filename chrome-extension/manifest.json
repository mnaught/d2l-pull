{
  "manifest_version": 3,
  "name": "D2L Pull",
  "version": "3.0.0",
  "description": "Download Brightspace (D2L) rosters and grades for your courses, plus data from add-on sources, and run your own post-processing script.",
  "key": "",
  "action": {
    "default_title": "D2L Pull",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_page": "options.html"
}

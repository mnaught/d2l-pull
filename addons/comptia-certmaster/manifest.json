{
  "manifest_version": 3,
  "name": "D2L Pull \u2013 CompTIA CertMaster",
  "version": "1.0.0",
  "description": "Source add-on for D2L Pull: CompTIA CertMaster lab gradebooks and quiz reports, exactly as CertMaster exports them.",
